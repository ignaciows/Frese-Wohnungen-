// Frese Wohnung — internal housing-search workbench.
//
// Modelling rules that matter here:
//  * A Listing exists independently of any candidate.
//  * Candidate-specific score/status lives on CandidateListingMatch.
//  * ContactAttempt is append-only history: who contacted what, when, with which exact message.
//  * ListingFact keeps extraction evidence; manual overrides never erase it.
//  * A SearchRun snapshots the profile and the source mappings it used.

generator client {
  provider      = "prisma-client-js"
  // Cover local dev (native) and both common Linux container flavours Railway
  // / Fly / Render / Docker use in production.
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- users

enum Role {
  ADMIN
  COLLEAGUE
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(COLLEAGUE)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  candidateCases   CandidateCase[]
  searchRuns       SearchRun[]
  sourceChecksDone SourceCheck[]             @relation("SourceCheckCheckedBy")
  sourceClaims     SourceCheck[]             @relation("SourceCheckClaimedBy")
  listingsImported Listing[]
  claims           ListingClaim[]
  contactAttempts  ContactAttempt[]
  contactOutcomes  ContactAttempt[]          @relation("ContactOutcomeBy")
  contactMessages  ContactMessage[]
  systemTransfers  SystemTransfer[]
  auditEvents      AuditEvent[]
  corrections      ListingFact[]
  settingsUpdated  AppSetting[]
  messagesUpdated  ApplicationMessage[]
  appointments     Appointment[]
  sharedDecisions  SharedHousingSuggestion[]
  portalAccounts   PortalAccount[]
  tasksCompleted   FollowUpTask[]
}

// ------------------------------------------------------- candidate case

enum CaseStatus {
  ACTIVE
  ARCHIVED
}

model CandidateCase {
  id          String     @id @default(cuid())
  reference   String     @unique // internal, pseudonymous reference (e.g. "CAND-2026-014")
  displayName String
  notes       String?
  status      CaseStatus @default(ACTIVE)
  createdById String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  /// When the employment contract was signed in the existing Frese system.
  /// The housing search clock starts here, not when someone got around to
  /// creating the case — that is what makes the waiting time honest.
  contractSignedAt DateTime?
  /// Set once a flat is secured; retires the case from the priority queue.
  housingSecuredAt DateTime?

  /// Last time a discovery sweep actually ran a search for *this* candidate.
  ///
  /// Separate from the global sweep timestamp on purpose. The sweep is shared
  /// — five nurses at the same clinic produce one search — so "a sweep ran an
  /// hour ago" says nothing about whether it covered this candidate. Somebody
  /// opening a case wants today's flats for *this* person, and this is the
  /// only column that can answer that.
  lastSweptAt DateTime?

  /// --- shared-flat (WG) matching ---
  /// Only candidates who explicitly agreed are ever suggested as flatmates.
  /// Nothing is proposed to a candidate automatically; a colleague asks first.
  openToSharing Boolean @default(false)
  /// Optional, and only collected to support flatmate matching (shared
  /// language / familiarity). Free text, no dropdown of nationalities, and the
  /// matching rule that uses it can be switched off entirely in the settings.
  /// See docs/PRIVACY_AND_SECURITY.md before extending this.
  nationality   String?
  /// Free-text languages, e.g. "Hindi, Englisch".
  languages     String?

  createdBy          User                      @relation(fields: [createdById], references: [id])
  applicationMessage ApplicationMessage?
  searchProfile      SearchProfile?
  searchRuns         SearchRun[]
  matches            CandidateListingMatch[]
  contactAttempts    ContactAttempt[]
  claims             ListingClaim[]
  auditEvents        AuditEvent[]
  appointments       Appointment[]
  sharedAsA          SharedHousingSuggestion[] @relation("SharedCaseA")
  sharedAsB          SharedHousingSuggestion[] @relation("SharedCaseB")
  weeklySummaries    WeeklySummary[]
  followUpTasks      FollowUpTask[]
  notifications      Notification[]

  @@index([status])
}

/// The personalised application message, pasted by a colleague. Never sent to an
/// external service; snapshotted verbatim into every ContactAttempt.
model ApplicationMessage {
  id              String   @id @default(cuid())
  candidateCaseId String   @unique
  body            String   @default("")
  revision        Int      @default(0)
  updatedById     String?
  updatedAt       DateTime @updatedAt

  candidateCase CandidateCase @relation(fields: [candidateCaseId], references: [id], onDelete: Cascade)
  updatedBy     User?         @relation(fields: [updatedById], references: [id])
}

enum FurnishedPreference {
  REQUIRED
  PREFERRED
  EITHER
}

enum WbsStatus {
  AVAILABLE
  NOT_AVAILABLE
  UNKNOWN
}

enum CommuteMode {
  CAR
  PUBLIC_TRANSPORT
  BIKE
  WALK
}

model SearchProfile {
  id              String @id @default(cuid())
  candidateCaseId String @unique

  workplaceAddress    String
  workplaceCity       String?
  workplacePostalCode String?
  workplaceLat        Float?
  workplaceLon        Float?
  geocodeStatus       String  @default("UNKNOWN") // UNKNOWN | RESOLVED | FAILED | MANUAL

  maxWarmmieteCents Int       @default(90000)
  moveInDate        DateTime?
  adults            Int       @default(1)
  children          Int       @default(0)
  minRooms          Float     @default(1)
  preferredRooms    Float     @default(2)

  furnished         FurnishedPreference @default(PREFERRED)
  maxCommuteMinutes Int?                @default(35)
  radiusKm          Int?
  commuteMode       CommuteMode         @default(CAR)
  wbsStatus         WbsStatus           @default(UNKNOWN)
  pets              String? // free text, optional ("Katze")
  temporaryMode     Boolean             @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  candidateCase CandidateCase @relation(fields: [candidateCaseId], references: [id], onDelete: Cascade)
}

// ------------------------------------------------------- source registry

// How a source's adverts reach us. Only two ways exist, and which one applies
// is a property of the portal, not a setting:
//
//   DISCOVERY   — the app reads the portal's own result list (Kleinanzeigen).
//   EMAIL_ALERT — the portal mails new hits to the shared mailbox because a
//                 colleague saved a search there (ImmoScout24, Immowelt).
//
// Stored as a plain string rather than an enum so adding a third route never
// needs a migration. See docs/QUELLEN.md.

model Source {
  id         String  @id @default(cuid())
  key        String  @unique
  name       String
  websiteUrl String
  /// Lower sorts first on the sources screen.
  priority   Int     @default(100)
  active     Boolean @default(true)

  /// DISCOVERY | EMAIL_ALERT — see the comment above.
  route String @default("DISCOVERY")

  /// Extra hints for the colleague who clicks through the portal by hand.
  manualRecipe String?
  notes        String?

  /// --- automatic discovery (route = DISCOVERY only) ---
  /// Which adapter fetches this source's own result list. Null = no automatic
  /// discovery. See domain/discovery/registry.ts.
  discoveryAdapter    String?
  /// Off by default. An admin turns discovery on per source.
  discoveryEnabled    Boolean   @default(false)
  /// Adapter-specific configuration (e.g. Kleinanzeigen's resolved town ids).
  discoveryConfig     Json?
  /// Set when a sweep was blocked or errored, so the UI can be honest about
  /// which sources are actually producing results.
  discoveryStatus     String? // OK | BLOCKED | ERROR | NEVER_RUN
  discoveryNote       String?
  lastDiscoveredAt    DateTime?
  /// How often this source is worth asking, in minutes. Null = use the global
  /// sweep interval.
  pollIntervalMinutes Int?

  filterMappings SourceFilterMapping[]
  sourceChecks   SourceCheck[]
  listings       Listing[]
  discoveryRuns  DiscoveryRun[]
  portalAccounts PortalAccount[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, priority])
  @@index([discoveryEnabled])
}

/// One automatic sweep of one source. Append-only, so "why did nothing new turn
/// up today" always has an answer — including the honest one, that the portal
/// blocked us.
model DiscoveryRun {
  id              String  @id @default(cuid())
  sourceId        String
  adapter         String
  /// Which candidate's criteria produced the query, when the sweep was scoped
  /// to one. Null for source-wide sweeps (feeds, sitemaps).
  candidateCaseId String?
  /// The resolved query (city, radius, price cap…) and the URL actually called.
  query           Json

  /// OK | BLOCKED | ERROR | SKIPPED | ROBOTS_DENIED
  status  String
  found   Int     @default(0)
  created Int     @default(0)
  updated Int     @default(0)
  retired Int     @default(0)
  message String?

  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  durationMs Int?

  source Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId, startedAt])
  @@index([startedAt])
}

enum MappingQuality {
  EXACT
  APPROXIMATE
  MANUAL
  UNSUPPORTED
  UNKNOWN
}

model SourceFilterMapping {
  id              String         @id @default(cuid())
  sourceId        String
  /// Canonical filter key — see domain/sources/canonicalFilters.ts
  canonicalFilter String
  quality         MappingQuality @default(UNKNOWN)
  /// What the portal calls it, e.g. "Warmmiete bis" or "Umkreis".
  portalLabel     String?
  note            String?

  source Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, canonicalFilter])
}

// ---------------------------------------------------------- search runs

enum SearchRunStatus {
  OPEN
  COMPLETED
}

model SearchRun {
  id              String          @id @default(cuid())
  candidateCaseId String
  createdById     String
  label           String
  status          SearchRunStatus @default(OPEN)
  /// Frozen copy of the SearchProfile at planning time. History must not change
  /// when the profile or a source mapping is edited later.
  profileSnapshot Json
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  candidateCase CandidateCase @relation(fields: [candidateCaseId], references: [id], onDelete: Cascade)
  createdBy     User          @relation(fields: [createdById], references: [id])
  sourceChecks  SourceCheck[]

  @@index([candidateCaseId, createdAt])
}

enum SourceCheckStatus {
  PENDING
  IN_PROGRESS
  CHECKED_NO_RESULTS
  CHECKED_RESULTS_IMPORTED
  UNAVAILABLE
  SKIPPED
}

/// One task per relevant source inside a search run. Manual tasks are first-class:
/// a source without a connector still gets a task, a recipe and a progress state.
model SourceCheck {
  id          String            @id @default(cuid())
  searchRunId String
  sourceId    String
  status      SourceCheckStatus @default(PENDING)

  importedCount     Int       @default(0)
  lastCheckedAt     DateTime?
  checkedById       String?
  claimedById       String?
  claimedUntil      DateTime?
  unavailableReason String?
  note              String?

  /// Snapshot of the filter mapping + generated recipe used for this run.
  /// Frozen at plan time so an old run still reads the way it did on the day.
  mappingSnapshot Json
  recipeSnapshot  Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  searchRun SearchRun @relation(fields: [searchRunId], references: [id], onDelete: Cascade)
  source    Source    @relation(fields: [sourceId], references: [id])
  checkedBy User?     @relation("SourceCheckCheckedBy", fields: [checkedById], references: [id])
  claimedBy User?     @relation("SourceCheckClaimedBy", fields: [claimedById], references: [id])

  @@unique([searchRunId, sourceId])
  @@index([searchRunId, status])
}

// -------------------------------------------------------------- listings

enum Furnishing {
  FULLY_FURNISHED
  FURNISHED
  PARTIALLY_FURNISHED
  FURNITURE_TAKEOVER
  UNFURNISHED
  UNKNOWN
}

enum PropertyType {
  APARTMENT
  WG_ROOM
  HOUSE
  FOR_SALE
  EXCHANGE
  TEMPORARY
  COMMERCIAL
  PARKING
  OTHER
  UNKNOWN
}

enum TriState {
  YES
  NO
  UNKNOWN
}

model Listing {
  id              String  @id @default(cuid())
  sourceId        String
  /// Normalised URL used for exact duplicate detection.
  canonicalUrl    String  @unique
  rawUrl          String
  /// Portal-side listing id when it can be derived from the URL.
  sourceListingId String?

  title          String
  descriptionRaw String  @default("")
  locationRaw    String  @default("")
  locationCity   String?
  locationPostal String?
  lat            Float?
  lon            Float?
  imageUrl       String?
  notes          String?

  // ---- normalised, effective values (manual override wins over extraction) ----
  propertyType PropertyType @default(UNKNOWN)
  furnishing   Furnishing   @default(UNKNOWN)

  warmMieteCents        Int?
  kaltMieteCents        Int?
  nebenkostenCents      Int?
  heizkostenCents       Int?
  otherMonthlyCents     Int?
  depositCents          Int?
  abloeseCents          Int?
  provisionNote         String?
  /// True when a real monthly total is known (Warmmiete given, or Kalt + NK + Heiz).
  monthlyTotalComplete  Boolean @default(false)
  /// Best known monthly total in cents (may be null when unknown).
  effectiveMonthlyCents Int?

  rooms          Float?
  livingSpaceSqm Float?
  availableFrom  DateTime?
  availableNow   Boolean   @default(false)

  wbsRequired       TriState @default(UNKNOWN)
  exchangeRequired  TriState @default(UNKNOWN)
  petsAllowed       TriState @default(UNKNOWN)
  fittedKitchen     TriState @default(UNKNOWN)
  anmeldungPossible TriState @default(UNKNOWN)
  fixedTerm         TriState @default(UNKNOWN)
  minDurationMonths Int?
  maxDurationMonths Int?

  /// Free-form warnings surfaced in the UI (schufa, income proof, restrictions...).
  warnings String[] @default([])

  /// --- how to reach the landlord without opening the portal ---
  /// Only ever filled from what the ad itself publishes. Empty is normal and
  /// simply means this ad has to be answered through the portal form.
  contactEmail   String?
  contactName    String?
  contactPhone   String?
  /// Portal-side contact/enquiry form, when the ad exposes one.
  contactFormUrl String?

  extractorVersion String    @default("")
  /// Last time a source confirmed this ad still exists (e.g. it reappeared in
  /// a search-agent mail). Drives the freshness badge.
  lastSeenAt       DateTime?
  expired          Boolean   @default(false)
  expiredAt        DateTime?

  /// --- automatic discovery bookkeeping ---
  /// DISCOVERY | EMAIL | MANUAL — how this ad entered the system.
  origin          String    @default("MANUAL")
  firstSeenAt     DateTime  @default(now())
  /// Last time a discovery sweep found this ad in the source's *own* result
  /// list. Deliberately separate from lastSeenAt: disappearing from the result
  /// list is the earliest, cheapest signal that an ad is gone.
  lastListedAt    DateTime?
  /// Consecutive sweeps of this source that did not contain the ad. Only ever
  /// incremented by a sweep that itself succeeded, so a blocked portal cannot
  /// quietly retire its whole inventory.
  missedSweeps    Int       @default(0)
  /// Set when the automatic link check retired the ad, so the UI can say
  /// whether a human or the system marked it gone.
  expiredBySystem Boolean   @default(false)

  /// --- automatic liveness check ---
  lastCheckedAt    DateTime?
  /// ALIVE | GONE | BLOCKED | UNKNOWN
  lastCheckStatus  String?
  lastCheckReason  String?
  /// Consecutive confident "gone" verdicts. Reset by anything inconclusive, so
  /// a blocked portal can never expire a listing on its own.
  goneStreak       Int       @default(0)
  /// 0..100 — how likely the ad is to still be online, as read from the page
  /// text. Null means never checked. The middle band is deliberately kept
  /// visible ("zu prüfen") rather than hidden, because the reading is a
  /// heuristic and a wrongly hidden flat is one nobody ever hears about.
  onlineConfidence Int?
  /// The individual observations behind that number, so the UI can explain
  /// itself instead of asking to be believed.
  livenessSignals  Json?

  /// --- what the ad says about itself ---
  /// Publication date read from the page ("Online seit dem 04.08.2026"). Far
  /// more useful than importedAt: an ad found today can already be three weeks
  /// old, and three-week-old flats are usually gone.
  postedAt      DateTime?
  /// The wording it was read from, shown next to the date.
  postedAtLabel String?

  importedById String
  importedAt   DateTime @default(now())
  updatedAt    DateTime @updatedAt
  /// Optimistic-locking counter, guards against lost updates.
  version      Int      @default(0)

  source          Source                  @relation(fields: [sourceId], references: [id])
  importedBy      User                    @relation(fields: [importedById], references: [id])
  facts           ListingFact[]
  matches         CandidateListingMatch[]
  claims          ListingClaim[]
  contactAttempts ContactAttempt[]
  duplicateLinks  DuplicateMember[]
  appointments    Appointment[]
  followUpTasks   FollowUpTask[]
  notifications   Notification[]

  @@index([sourceId])
  @@index([sourceListingId])
  /// The default results query: live ads, newest discovery first.
  @@index([expired, lastListedAt])
  /// "Confirmed live first, then newest ad" — the order the result list uses.
  @@index([onlineConfidence, postedAt])
}

enum FactSource {
  STRUCTURED_FIELD
  DESCRIPTION
  TITLE
  DERIVED
  MANUAL
}

/// One extracted (or manually corrected) fact, with its evidence. Manual
/// corrections are added as new rows with isOverride = true; the original
/// extraction row is kept for audit and for building test fixtures.
model ListingFact {
  id               String     @id @default(cuid())
  listingId        String
  key              String
  valueJson        Json
  origin           FactSource
  evidence         String? // short snippet from the description
  confidence       Float      @default(0.5)
  extractorVersion String     @default("")
  isOverride       Boolean    @default(false)
  createdById      String?
  createdAt        DateTime   @default(now())

  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdBy User?   @relation(fields: [createdById], references: [id])

  @@index([listingId, key])
}

// -------------------------------------------------- candidate <-> listing

enum Compatibility {
  COMPATIBLE
  NEAR_MATCH
  INCOMPATIBLE
  INSUFFICIENT_DATA
}

enum MatchStatus {
  NEW
  FAVORITE
  IN_PROGRESS
  CONTACTED
  REJECTED
  EXPIRED
}

model CandidateListingMatch {
  id              String        @id @default(cuid())
  candidateCaseId String
  listingId       String
  compatibility   Compatibility @default(INSUFFICIENT_DATA)
  score           Float         @default(0)
  breakdown       Json
  reasons         Json
  blockers        Json
  status          MatchStatus   @default(NEW)
  rejectedReason  String?
  rankVersion     String        @default("")

  /// Wiedervorlage: come back to this listing on this date. Independent of the
  /// workflow status, so you can park something without rejecting it.
  followUpAt   DateTime?
  followUpNote String?
  computedAt   DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  candidateCase CandidateCase @relation(fields: [candidateCaseId], references: [id], onDelete: Cascade)
  listing       Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([candidateCaseId, listingId])
  @@index([candidateCaseId, status])
  @@index([candidateCaseId, compatibility, score])
}

/// Short renewable "I am working on this" claim. Expires on its own so a closed
/// browser never leaves a permanent lock.
model ListingClaim {
  id              String    @id @default(cuid())
  listingId       String
  candidateCaseId String
  userId          String
  claimedAt       DateTime  @default(now())
  expiresAt       DateTime
  releasedAt      DateTime?

  listing       Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  candidateCase CandidateCase @relation(fields: [candidateCaseId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id])

  @@index([listingId, expiresAt])
}

/// How the landlord/agency replied to a contact attempt.
enum ResponseOutcome {
  AWAITING
  POSITIVE
  NEGATIVE
  NEEDS_INFO
}

enum MessageDirection {
  OUTGOING
  INCOMING
}

/// Append-only. One row = one deliberate, confirmed contact.
model ContactAttempt {
  id              String   @id @default(cuid())
  listingId       String
  candidateCaseId String
  userId          String
  contactedAt     DateTime @default(now())
  /// Verbatim copy of the message that was actually used.
  messageSnapshot String
  channel         String   @default("PORTAL_FORM")
  note            String?
  /// Set when an admin-permitted duplicate contact was forced through.
  overrideReason  String?

  /// --- sending from inside the tool ---
  /// Where the message actually went, when we sent it ourselves.
  sentToAddress     String?
  /// PENDING | SENT | FAILED | MANUAL — MANUAL means a colleague sent it in the
  /// portal and only recorded it here.
  deliveryStatus    String  @default("MANUAL")
  deliveryError     String?
  /// Unique token embedded in the reply-to address (plus addressing), so an
  /// answer landing in the shared mailbox can be matched back to this attempt
  /// without guessing from the subject line.
  threadToken       String? @unique
  /// Message-ID of the mail we sent, used to match replies by In-Reply-To.
  outboundMessageId String?

  /// Reply tracking. AWAITING until a colleague records an answer.
  outcome     ResponseOutcome @default(AWAITING)
  outcomeAt   DateTime?
  outcomeById String?
  outcomeNote String?

  listing        Listing          @relation(fields: [listingId], references: [id])
  candidateCase  CandidateCase    @relation(fields: [candidateCaseId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id])
  outcomeBy      User?            @relation("ContactOutcomeBy", fields: [outcomeById], references: [id])
  systemTransfer SystemTransfer?
  messages       ContactMessage[]
  followUpTasks  FollowUpTask[]
  notifications  Notification[]

  /// DB-level guarantee: one candidate can only be registered against a listing once.
  @@unique([listingId, candidateCaseId])
  @@index([listingId])
}

/// A logged message in the conversation with a landlord/agency. Colleagues
/// paste what they sent and what came back, so the whole team can see the
/// state of a conversation without opening five portal inboxes.
model ContactMessage {
  id               String           @id @default(cuid())
  contactAttemptId String
  direction        MessageDirection
  body             String
  occurredAt       DateTime         @default(now())
  /// Null when the message was collected automatically from the mailbox rather
  /// than typed by a colleague.
  recordedById     String?
  createdAt        DateTime         @default(now())

  /// --- automatic mailbox collection ---
  subject     String?
  fromAddress String?
  /// RFC Message-ID. Unique so re-reading the mailbox never duplicates a reply.
  externalId  String?   @unique
  /// Unread replies are what the notification badge counts.
  readAt      DateTime?

  contactAttempt ContactAttempt @relation(fields: [contactAttemptId], references: [id], onDelete: Cascade)
  recordedBy     User?          @relation(fields: [recordedById], references: [id])

  @@index([contactAttemptId, occurredAt])
  @@index([direction, readAt])
}

/// Tracks the manual copy of the three fields into the separate company system.
/// There is deliberately no API integration with that system.
model SystemTransfer {
  id               String    @id @default(cuid())
  contactAttemptId String    @unique
  objectLabel      String
  link             String
  location         String
  registeredAt     DateTime?
  registeredById   String?
  updatedAt        DateTime  @updatedAt

  contactAttempt ContactAttempt @relation(fields: [contactAttemptId], references: [id], onDelete: Cascade)
  registeredBy   User?          @relation(fields: [registeredById], references: [id])
}

// ------------------------------------------------------------- duplicates

enum DuplicateStatus {
  SUSPECTED
  CONFIRMED
  DISMISSED
}

model DuplicateGroup {
  id        String            @id @default(cuid())
  status    DuplicateStatus   @default(SUSPECTED)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  members   DuplicateMember[]
}

model DuplicateMember {
  id         String @id @default(cuid())
  groupId    String
  listingId  String
  confidence Float  @default(0)
  reasons    Json

  group   DuplicateGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  listing Listing        @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([groupId, listingId])
  @@index([listingId])
}

// ----------------------------------------------------------------- audit

model AuditEvent {
  id              String   @id @default(cuid())
  userId          String?
  candidateCaseId String?
  entityType      String
  entityId        String
  action          String
  fromState       String?
  toState         String?
  reason          String?
  meta            Json?
  createdAt       DateTime @default(now())

  user          User?          @relation(fields: [userId], references: [id])
  candidateCase CandidateCase? @relation(fields: [candidateCaseId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([candidateCaseId, createdAt])
}

enum AppointmentKind {
  VIDEO_CALL
  VIEWING
  PHONE_CALL
  HANDOVER
  OTHER
}

enum AppointmentStatus {
  SCHEDULED
  DONE_POSITIVE
  DONE_NEGATIVE
  CANCELLED
  NO_SHOW
}

/// A planned video call, viewing or handover. Kept in this tool so a colleague
/// sees what is coming up without opening a separate calendar.
model Appointment {
  id              String            @id @default(cuid())
  candidateCaseId String
  listingId       String?
  kind            AppointmentKind
  scheduledAt     DateTime
  durationMinutes Int?
  /// Address for a viewing, or the meeting link for a video call.
  location        String?
  notes           String?
  status          AppointmentStatus @default(SCHEDULED)
  outcomeNote     String?
  outcomeAt       DateTime?
  createdById     String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  candidateCase CandidateCase @relation(fields: [candidateCaseId], references: [id], onDelete: Cascade)
  listing       Listing?      @relation(fields: [listingId], references: [id], onDelete: SetNull)
  createdBy     User          @relation(fields: [createdById], references: [id])

  @@index([candidateCaseId, scheduledAt])
  @@index([scheduledAt, status])
}

/// A suggested flatmate pairing between two candidate cases. Deterministic and
/// advisory only — a colleague decides whether to even mention it.
model SharedHousingSuggestion {
  id            String    @id @default(cuid())
  /// Always stored with caseAId < caseBId so a pair exists at most once.
  caseAId       String
  caseBId       String
  score         Float
  reasons       Json
  /// PROPOSED -> a colleague has not acted yet.
  status        String    @default("PROPOSED") // PROPOSED | ACCEPTED | DISMISSED
  decidedById   String?
  decidedAt     DateTime?
  dismissReason String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  caseA     CandidateCase @relation("SharedCaseA", fields: [caseAId], references: [id], onDelete: Cascade)
  caseB     CandidateCase @relation("SharedCaseB", fields: [caseBId], references: [id], onDelete: Cascade)
  decidedBy User?         @relation(fields: [decidedById], references: [id])

  @@unique([caseAId, caseBId])
}

/// One row per alert email we have looked at. The unique messageId makes
/// ingestion idempotent: re-reading the mailbox never creates duplicates.
model EmailIngestLog {
  id              String   @id @default(cuid())
  messageId       String   @unique
  fromAddress     String
  subject         String
  receivedAt      DateTime
  candidateCaseId String?
  sourceKey       String?
  listingsCreated Int      @default(0)
  listingsSeen    Int      @default(0)
  /// PROCESSED | NO_LINKS | UNKNOWN_SOURCE | UNKNOWN_CANDIDATE | ERROR
  status          String
  note            String?
  createdAt       DateTime @default(now())

  @@index([createdAt])
}

/// Automatically generated activity snapshot for one candidate and one ISO
/// week. Regenerated idempotently, so re-running the job never duplicates a
/// week; the numbers are always derived from the underlying records.
model WeeklySummary {
  id              String   @id @default(cuid())
  candidateCaseId String
  /// Monday 00:00 UTC of the week this row covers.
  weekStart       DateTime

  anfragenSent      Int @default(0)
  positiveReplies   Int @default(0)
  negativeReplies   Int @default(0)
  awaitingReplies   Int @default(0)
  listingsImported  Int @default(0)
  sourcesChecked    Int @default(0)
  appointmentsHeld  Int @default(0)
  appointmentsAhead Int @default(0)

  generatedAt DateTime @default(now())

  candidateCase CandidateCase @relation(fields: [candidateCaseId], references: [id], onDelete: Cascade)

  @@unique([candidateCaseId, weekStart])
  @@index([weekStart])
}

/// Starting estimate of how hard a region's housing market is, per postal
/// prefix (e.g. "749") or city. Only the SEED lives here — observed rates are
/// derived live from our own contacts so the two can never drift apart.
model MarketRegion {
  id    String @id @default(cuid())
  key   String @unique
  label String

  /// 0 = easy, 100 = brutal. An editable starting point, replaced by our own
  /// measurements as soon as enough Anfragen exist for the region.
  seededDifficulty Int     @default(50)
  /// Why this seed was chosen — shown in the UI so nobody mistakes it for data.
  seedNote         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ------------------------------------------------- accounts & messaging

enum AccountKind {
  /// A login the team holds on a housing portal.
  PORTAL
  /// The shared mailbox Anfragen are sent from and replies arrive in.
  MAILBOX
}

/// A per-site account the team owns, so contacting can happen from inside the
/// tool instead of in five separate portal tabs.
///
/// Secrets are stored encrypted (AES-256-GCM, key from CREDENTIAL_KEY) and are
/// never sent back to the browser — the UI only ever learns whether a secret is
/// set. See docs/PRIVACY_AND_SECURITY.md.
model PortalAccount {
  id       String      @id @default(cuid())
  kind     AccountKind @default(PORTAL)
  /// Catalogue source this account belongs to, when there is one.
  sourceId String?
  /// Stable key even for sites outside the catalogue.
  siteKey  String
  label    String

  loginName          String?
  /// AES-256-GCM ciphertext of the password / app password / API token.
  secretEnc          String?
  /// Second secret for the rare case that IMAP and SMTP differ.
  secondarySecretEnc String?
  /// Non-secret extras: host, port, profile URL, alert address, free notes.
  meta               Json?

  /// Address landlord replies come back to for this portal.
  replyToAddress String?

  active         Boolean   @default(true)
  /// UNVERIFIED | OK | FAILED
  status         String    @default("UNVERIFIED")
  statusNote     String?
  lastVerifiedAt DateTime?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  source    Source? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  createdBy User?   @relation(fields: [createdById], references: [id])

  @@unique([siteKey, label])
  @@index([kind, active])
}

enum TaskKind {
  /// "You wrote three days ago — has anyone answered?"
  CHECK_REPLY
  /// Wiedervorlage on a listing that was parked rather than rejected.
  REVIEW_LISTING
  CUSTOM
}

enum TaskState {
  OPEN
  DONE
  DISMISSED
}

/// The daily to-do list. Created automatically when a message goes out, so
/// "check whether they replied" never depends on somebody remembering.
model FollowUpTask {
  id               String  @id @default(cuid())
  candidateCaseId  String
  listingId        String?
  contactAttemptId String?

  kind  TaskKind
  title String
  note  String?
  dueAt DateTime
  state TaskState @default(OPEN)

  completedAt   DateTime?
  completedById String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  candidateCase  CandidateCase   @relation(fields: [candidateCaseId], references: [id], onDelete: Cascade)
  listing        Listing?        @relation(fields: [listingId], references: [id], onDelete: Cascade)
  contactAttempt ContactAttempt? @relation(fields: [contactAttemptId], references: [id], onDelete: Cascade)
  completedBy    User?           @relation(fields: [completedById], references: [id])

  /// One open reply-check per contact attempt; re-running the job never piles
  /// duplicates onto the same conversation.
  @@unique([contactAttemptId, kind])
  @@index([state, dueAt])
  @@index([candidateCaseId, state])
}

/// In-app notification. Deliberately not an email: the point is that everything
/// shows up in one place.
model Notification {
  id   String @id @default(cuid())
  /// REPLY_RECEIVED | TASK_DUE | LISTING_RETIRED | DISCOVERY_RESULT | DISCOVERY_PROBLEM
  kind String

  title String
  body  String?
  /// In-app link to whatever this is about.
  url   String?

  candidateCaseId  String?
  listingId        String?
  contactAttemptId String?

  readAt    DateTime?
  createdAt DateTime  @default(now())

  candidateCase  CandidateCase?  @relation(fields: [candidateCaseId], references: [id], onDelete: Cascade)
  listing        Listing?        @relation(fields: [listingId], references: [id], onDelete: Cascade)
  contactAttempt ContactAttempt? @relation(fields: [contactAttemptId], references: [id], onDelete: Cascade)

  @@index([readAt, createdAt])
}

/// Small admin-editable key/value settings (copy format, ranking weights).
model AppSetting {
  key         String   @id
  valueJson   Json
  updatedById String?
  updatedAt   DateTime @updatedAt

  updatedBy User? @relation(fields: [updatedById], references: [id])
}
