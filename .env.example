# --- Frese Wohnung configuration -------------------------------------------
# Copy to .env and fill in. NEVER commit a filled .env.

# PostgreSQL connection string for the shared database.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/frese_wohnung?schema=public"

# Separate database used by `npm test`. Its contents are wiped by the tests.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/frese_wohnung_test?schema=public"

# Secret used to encrypt the session cookie (iron-session). Minimum 32 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=""

# Cookie name and https-only flag. Set SESSION_SECURE_COOKIE=true in production.
SESSION_COOKIE_NAME="frese_wohnung_session"
SESSION_SECURE_COOKIE="false"

# Password for the seeded demo admin. Only used by `npm run db:seed`.
SEED_ADMIN_PASSWORD=""

# Set to "true" to make `npm run db:seed` wipe and recreate the demo candidate
# (drops any state built on top of it). Default: skip if demo already exists.
SEED_FORCE_RESET="false"

# --- Zugangsdaten-Verschlüsselung -------------------------------------------
# Verschlüsselt die Portal- und Postfach-Passwörter, die das Team in den
# Einstellungen hinterlegt (AES-256-GCM). Ohne diesen Schlüssel *weigert* sich
# die App, ein Passwort zu speichern — sie legt nichts im Klartext ab.
# Mindestens 32 Zeichen. Erzeugen mit:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Wird der Schlüssel getauscht, müssen alle Zugangsdaten neu eingetragen werden.
CREDENTIAL_KEY=""

# --- Automatische Suche -----------------------------------------------------
# Kennung, mit der sich die App bei fremden Servern meldet. Ehrlich halten:
# ein getarnter Browser-User-Agent ist genau das, was die Portale untersagen.
# Ein Kontakthinweis gehört hinein, damit ein Seitenbetreiber uns erreichen kann.
DISCOVERY_USER_AGENT="FreseWohnungBot/1.0 (+https://ihre-domain.example/impressum)"

# --- Optional geocoding -----------------------------------------------------
# Leave GEOCODER=none to run entirely without an external geocoder. The app then
# uses the built-in offline gazetteer plus manually entered coordinates and shows
# "Entfernung unbekannt" where it cannot compute a distance.
# Supported: none | nominatim
# Address lookup on the candidate form uses Nominatim by default: no API key,
# no billing account, and a handful of interactive requests per candidate.
GEOCODER="nominatim"
# Required by Nominatim's usage policy: a contact address identifying this
# deployment. Only set this if you have read and accept their terms.
GEOCODER_USER_AGENT=""
GEOCODER_BASE_URL="https://nominatim.openstreetmap.org"

# --- Optional AI (disabled by default; not used by any core feature) --------
# The product is fully functional with AI_ENRICHMENT_ENABLED=false.
AI_ENRICHMENT_ENABLED="false"
AI_PROVIDER=""
AI_API_KEY=""

# --- Suchagent-Postfach (optional) -------------------------------------
# Portale schicken Suchagent-Mails an dieses Postfach; die App liest sie per
# IMAP und legt daraus Anzeigen an. Kein Scraping, keine Portal-Passwörter.
# Adressierung pro Kandidat über Plus-Adressen:
#   wohnungen+CAND-2026-014@deine-domain.de
MAIL_IMAP_HOST=""
MAIL_IMAP_PORT="993"
MAIL_IMAP_SECURE="true"
MAIL_IMAP_USER=""
MAIL_IMAP_PASSWORD=""
MAIL_IMAP_MAILBOX="INBOX"

# Das Postfach lässt sich alternativ (und bequemer) in der App unter
# „Einstellungen → Konten & Postfach" hinterlegen. Ist dort eines eingetragen,
# hat es Vorrang vor diesen Variablen; sonst gelten weiterhin die hier.
# Nur der Weg über die Einstellungen kann auch senden.

# Shared secret für die Cron-Endpoints. Ohne Wert sind sie deaktiviert:
#   POST /api/ingest/email      Postfach lesen
#   POST /api/checks/listings   Links prüfen
#   POST /api/discovery/run     Quellen nach neuen Anzeigen durchsuchen
INGEST_TOKEN=""

# --- Telegram (optional) ------------------------------------------------
# Bot über @BotFather anlegen, Token hier eintragen. TELEGRAM_CHAT_ID ist die
# Gruppe oder der Chat, in dem das Team Benachrichtigungen bekommt.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
# Frei gewähltes Geheimnis; wird beim Setzen des Webhooks an Telegram
# übergeben und bei jedem eingehenden Aufruf geprüft.
TELEGRAM_WEBHOOK_SECRET=""
