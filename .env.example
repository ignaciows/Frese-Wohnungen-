# --- Frese Wohnung configuration -------------------------------------------
# Copy to .env and fill in. NEVER commit a filled .env.

# PostgreSQL connection string for the shared database.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/frese_wohnung?schema=public"

# Separate database used by `npm test`. Its contents are wiped by the tests.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/frese_wohnung_test?schema=public"

# Secret used to encrypt the session cookie (iron-session). Minimum 32 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=""

# Cookie name and https-only flag. Set SESSION_SECURE_COOKIE=true in production.
SESSION_COOKIE_NAME="frese_wohnung_session"
SESSION_SECURE_COOKIE="false"

# Password for the seeded demo admin. Only used by `npm run db:seed`.
SEED_ADMIN_PASSWORD=""

# Set to "true" to make `npm run db:seed` wipe and recreate the demo candidate
# (drops any state built on top of it). Default: skip if demo already exists.
SEED_FORCE_RESET="false"

# --- Optional geocoding -----------------------------------------------------
# Leave GEOCODER=none to run entirely without an external geocoder. The app then
# uses the built-in offline gazetteer plus manually entered coordinates and shows
# "Entfernung unbekannt" where it cannot compute a distance.
# Supported: none | nominatim
GEOCODER="none"
# Required by Nominatim's usage policy: a contact address identifying this
# deployment. Only set this if you have read and accept their terms.
GEOCODER_USER_AGENT=""
GEOCODER_BASE_URL="https://nominatim.openstreetmap.org"

# --- Optional AI (disabled by default; not used by any core feature) --------
# The product is fully functional with AI_ENRICHMENT_ENABLED=false.
AI_ENRICHMENT_ENABLED="false"
AI_PROVIDER=""
AI_API_KEY=""
